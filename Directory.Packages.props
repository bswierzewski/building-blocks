<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Security overrides for transitive dependencies -->
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <Import Project="BuildingBlocks.Core\BuildingBlocks.Core.Packages.props" Condition="Exists('BuildingBlocks.Core\BuildingBlocks.Core.Packages.props')" />
  <Import Project="BuildingBlocks.Hosting\BuildingBlocks.Hosting.Packages.props" Condition="Exists('BuildingBlocks.Hosting\BuildingBlocks.Hosting.Packages.props')" />
  <Import Project="BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.Packages.props" Condition="Exists('BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.Packages.props')" />
  <Import Project="BuildingBlocks.Tests\BuildingBlocks.Tests.Packages.props" Condition="Exists('BuildingBlocks.Tests\BuildingBlocks.Tests.Packages.props')" />
  <Import Project="BuildingBlocks.Soap\BuildingBlocks.Soap.Packages.props" Condition="Exists('BuildingBlocks.Soap\BuildingBlocks.Soap.Packages.props')" />
  <Import Project="BuildingBlocks.Clerk\BuildingBlocks.Clerk.Packages.props" Condition="Exists('BuildingBlocks.Clerk\BuildingBlocks.Clerk.Packages.props')" />
</Project>
